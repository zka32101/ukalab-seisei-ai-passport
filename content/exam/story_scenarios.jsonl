// 骨組み用のサンプル（5件）。ストーリー型の体験（決定38、複数資格共用の汎用エンジン）の初期データ。本番配信前に拡充・運営者確認が必要（content/exam/README.md 参照）。
{"scenarioId": "sap-story-0001", "examId": "seisei_ai_passport", "subjectId": "ch3", "title": "社内チャットボット導入プロジェクト", "description": "架空の企業の情報システム部門として、社内向けAIチャットボットの導入を進めるストーリー。各段階での判断を選びながら進める。", "chapters": [{"chapterId": "ch-01", "situation": "導入目的をどう定めるか、検討する段階に来た。", "choices": [{"choiceId": "ch-01-opt-1", "text": "まず解決したい業務課題（問い合わせ対応の負荷等）を明確にし、それに沿って要件を決める", "isRecommended": true, "feedback": "目的を明確にすることで、後工程での機能選定や評価がぶれにくくなる。"}, {"choiceId": "ch-01-opt-2", "text": "とりあえず最新のAIエージェント技術を導入し、使い道は後で考える", "isRecommended": false, "feedback": "技術起点で導入すると、実際の業務課題と合わないまま終わるリスクが高い。"}]}, {"chapterId": "ch-02", "situation": "チャットボットに社内マニュアルの内容を回答させたい。どう実現するか検討している。", "choices": [{"choiceId": "ch-02-opt-1", "text": "RAG（検索拡張生成）で社内文書を検索しながら回答させる構成にする", "isRecommended": true, "feedback": "RAGを使うことで、モデルの知識カットオフ以降の情報や社内固有の情報にも対応しやすくなる。"}, {"choiceId": "ch-02-opt-2", "text": "全ての社内マニュアルの内容をプロンプトに一括で貼り付けて毎回送る", "isRecommended": false, "feedback": "コンテキストウィンドウの制約や、情報量が多い場合のコストの観点から非効率になりやすい。"}]}, {"chapterId": "ch-03", "situation": "運用開始前の最終チェックの段階。導入をどう進めるべきか。", "choices": [{"choiceId": "ch-03-opt-1", "text": "限定的な部署で試験運用し、フィードバックを得てから全社展開する", "isRecommended": true, "feedback": "段階的な展開により、問題点を早期に発見し、影響範囲を抑えながら改善できる。"}, {"choiceId": "ch-03-opt-2", "text": "準備ができたら、確認なしに全社員へ一斉展開する", "isRecommended": false, "feedback": "想定外の不具合や誤回答が全社規模で発生するリスクがあり、段階的な展開が望ましい。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0002", "examId": "seisei_ai_passport", "subjectId": "ch5", "title": "生成AIを使った新人教育プログラムの構築", "description": "架空の企業の人事部門として、生成AIを活用した新人教育プログラムを構築するストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "新人研修の教材作成に生成AIを活用する方針を検討している。", "choices": [{"choiceId": "ch-01-opt-1", "text": "既存の研修内容をベースに、AIで要約・リライトしつつ、最終的に人間が確認する運用にする", "isRecommended": true, "feedback": "AI生成コンテンツも人間の確認を経ることで、品質と正確性を担保できる。"}, {"choiceId": "ch-01-opt-2", "text": "AIが生成した内容をそのまま確認なしに研修教材として配布する", "isRecommended": false, "feedback": "AIの出力にはハルシネーション等のリスクがあり、確認なしの配布は不正確な情報を広める危険がある。"}]}, {"chapterId": "ch-02", "situation": "新人からの質問に答えるAIチューターを用意する計画を進めている。", "choices": [{"choiceId": "ch-02-opt-1", "text": "役割（チューター）・口調・回答範囲をシステムプロンプトで明確に設定する", "isRecommended": true, "feedback": "システムプロンプトで役割や制約を明示することで、一貫性のある望ましい応答を得やすくなる。"}, {"choiceId": "ch-02-opt-2", "text": "特に指示を与えず、AIの自由な応答に任せる", "isRecommended": false, "feedback": "指示が無いと、口調や回答範囲がぶれやすく、新人教育の目的に合わない応答が出る可能性がある。"}]}, {"chapterId": "ch-03", "situation": "プログラムの効果を評価する段階に入った。", "choices": [{"choiceId": "ch-03-opt-1", "text": "新人の理解度やフィードバックを収集し、教材・運用を継続的に改善する", "isRecommended": true, "feedback": "生成AI活用の効果を継続的に検証し、改善を続けることが望ましい運用。"}, {"choiceId": "ch-03-opt-2", "text": "一度構築したら、その後は見直しを行わない", "isRecommended": false, "feedback": "AIの活用方法や教材は、継続的な見直しと改善が重要。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0003", "examId": "seisei_ai_passport", "subjectId": "ch3", "title": "AIエージェントによる業務自動化プロジェクト", "description": "架空の企業の業務改善チームとして、請求書処理業務にAIエージェントを導入するストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "請求書処理業務をAIエージェントに任せる範囲を検討している。", "choices": [{"choiceId": "ch-01-opt-1", "text": "金額の確定や送付など影響の大きい処理には、人間による最終確認（Human-in-the-Loop）を組み込む", "isRecommended": true, "feedback": "影響の大きい処理に人間の確認を組み込むことで、ミスの拡大を防ぎやすくなる。"}, {"choiceId": "ch-01-opt-2", "text": "全ての処理を完全に自動化し、人間の確認は一切挟まない", "isRecommended": false, "feedback": "設定ミス等があった場合に被害が拡大するリスクが高く、重要な処理には人間の確認が望ましい。"}]}, {"chapterId": "ch-02", "situation": "AIエージェントが使えるツール・権限の設計を検討している。", "choices": [{"choiceId": "ch-02-opt-1", "text": "業務に必要な最小限のツール・権限だけを与える（最小権限の原則）", "isRecommended": true, "feedback": "必要最小限の権限にすることで、誤動作や悪用による被害範囲を抑えられる。"}, {"choiceId": "ch-02-opt-2", "text": "将来の拡張に備えて、できるだけ多くのツール・権限を最初から与える", "isRecommended": false, "feedback": "不要に広い権限を与えると、誤動作時の被害範囲が大きくなるリスクがある。"}]}, {"chapterId": "ch-03", "situation": "運用開始後、処理件数が急増したときの対応を検討している。", "choices": [{"choiceId": "ch-03-opt-1", "text": "処理状況をログで継続的にモニタリングし、異常があれば早期に対応する", "isRecommended": true, "feedback": "AIエージェントの処理状況を継続的に監視することで、異常の早期発見・対応につながる。"}, {"choiceId": "ch-03-opt-2", "text": "順調に動いているように見えるので、モニタリングの仕組みは不要とする", "isRecommended": false, "feedback": "AIエージェントの自動処理は、継続的なモニタリングなしでは異常の発見が遅れるリスクがある。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0004", "examId": "seisei_ai_passport", "subjectId": "ch5", "title": "生成AIコンテンツ制作チームの立ち上げ", "description": "架空のメディア企業で、生成AIを活用したコンテンツ制作チームを立ち上げるストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "記事作成に生成AIを活用する運用ルールを検討している。", "choices": [{"choiceId": "ch-01-opt-1", "text": "AI生成である旨の開示方針と、公開前の事実確認（ファクトチェック）の手順を定める", "isRecommended": true, "feedback": "透明性の確保と事実確認の手順を定めることで、読者の信頼と正確性を両立できる。"}, {"choiceId": "ch-01-opt-2", "text": "AIが生成した記事は、効率化のためすべてそのまま公開する", "isRecommended": false, "feedback": "ハルシネーションのリスクを踏まえ、事実確認なしの公開は誤情報拡散のリスクがある。"}]}, {"chapterId": "ch-02", "situation": "画像生成AIで使うイラストの著作権リスクについて検討している。", "choices": [{"choiceId": "ch-02-opt-1", "text": "既存の著作物に似すぎていないかを確認し、商用利用の規約も確認する", "isRecommended": true, "feedback": "既存作品との類似性や利用規約の確認は、著作権侵害リスクを減らすために重要。"}, {"choiceId": "ch-02-opt-2", "text": "AIが生成したものだから、著作権の確認は不要と考える", "isRecommended": false, "feedback": "AI生成物でも、既存作品に類似する場合は著作権侵害のリスクがある。"}]}, {"chapterId": "ch-03", "situation": "チームの生成AI活用について、社外への説明をどうするか検討している。", "choices": [{"choiceId": "ch-03-opt-1", "text": "生成AIをどのように活用しているかを、適切な範囲で開示する方針にする", "isRecommended": true, "feedback": "AI活用の透明性を確保することは、読者・視聴者からの信頼を維持するうえで重要。"}, {"choiceId": "ch-03-opt-2", "text": "生成AIを使っていることは一切公表しない方針にする", "isRecommended": false, "feedback": "活用実態を隠すことは、発覚した際の信頼低下リスクがあり、適切な開示が望ましい。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0005", "examId": "seisei_ai_passport", "subjectId": "ch4", "title": "AI倫理ガバナンス体制の構築", "description": "架空の企業の経営企画部門として、社内のAI利用に関するガバナンス体制を構築するストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "社内でのAI利用ルールを整備する最初の段階。", "choices": [{"choiceId": "ch-01-opt-1", "text": "まず社内でのAI利用実態（シャドーAIの有無等）を調査し、現状を把握する", "isRecommended": true, "feedback": "現状把握を先に行うことで、実態に合ったルール整備ができる。"}, {"choiceId": "ch-01-opt-2", "text": "実態調査をせず、他社のルールをそのままコピーして導入する", "isRecommended": false, "feedback": "自社の実態に合わないルールは、現場で守られずに形だけのものになりやすい。"}]}, {"chapterId": "ch-02", "situation": "AIツールの利用承認プロセスを設計する段階。", "choices": [{"choiceId": "ch-02-opt-1", "text": "リスクの大きさに応じて、承認の手続きの厳しさを変える（リスクベースアプローチ）", "isRecommended": true, "feedback": "リスクベースアプローチにより、低リスクな利用の手続きを簡素化しつつ、高リスクな利用は慎重に審査できる。"}, {"choiceId": "ch-02-opt-2", "text": "リスクの大小を問わず、すべてのAIツールに同じ厳しい承認手続きを課す", "isRecommended": false, "feedback": "一律に厳しい手続きを課すと、低リスクな利用まで滞り、現場の生産性が落ちるおそれがある。"}]}, {"chapterId": "ch-03", "situation": "ガバナンス体制を運用し始めてから数か月が経った段階。", "choices": [{"choiceId": "ch-03-opt-1", "text": "利用状況のモニタリングを続け、ルールを定期的に見直す", "isRecommended": true, "feedback": "AI技術やリスクは変化するため、ガバナンスも継続的な見直しが必要。"}, {"choiceId": "ch-03-opt-2", "text": "一度ルールを定めたら、その後は見直さない方針にする", "isRecommended": false, "feedback": "AI技術の進化や利用状況の変化に対応できず、ガバナンスが形骸化するリスクがある。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0006", "examId": "seisei_ai_passport", "subjectId": "ch5", "title": "生成AIを使ったマーケティングコンテンツ制作プロジェクト", "description": "架空の企業のマーケティング部門として、生成AIを活用したキャンペーンコンテンツ制作を進めるストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "キャンペーン用のSNSコピーや広告文を生成AIで作成する方針を検討している。", "choices": [{"choiceId": "ch-01-opt-1", "text": "ブランドトーンやガイドラインをプロンプトに明記し、ターゲット層や訴求ポイントも具体的に指定する", "isRecommended": true, "feedback": "プロンプトに具体的な条件を含めることで、ブランドイメージに沿った出力を得やすくなる。"}, {"choiceId": "ch-01-opt-2", "text": "「いい感じの広告文を作って」といった抽象的な指示だけを与えて量産する", "isRecommended": false, "feedback": "抽象的な指示では意図した出力が得られにくく、ブランドイメージとずれるリスクがある。"}]}, {"chapterId": "ch-02", "situation": "生成した広告コピーに、競合他社の有名なキャッチフレーズと似た表現が含まれていないか懸念が出た。", "choices": [{"choiceId": "ch-02-opt-1", "text": "既存の商標・著作物との類似性を確認し、問題があれば修正してから使用する", "isRecommended": true, "feedback": "既存の著作物や商標との類似性を確認することで、権利侵害のリスクを減らせる。"}, {"choiceId": "ch-02-opt-2", "text": "AIが生成したものなので、類似する表現があっても気にせずそのまま使用する", "isRecommended": false, "feedback": "AI生成物であっても、既存作品や商標に類似する場合は権利侵害のリスクがある。"}]}, {"chapterId": "ch-03", "situation": "生成AIで作成した画像素材をキャンペーンのビジュアルに使う計画だが、モデルの顔が実在の有名人に似ているとの指摘があった。", "choices": [{"choiceId": "ch-03-opt-1", "text": "パブリシティ権・肖像権の侵害にならないか確認し、似すぎている場合は生成し直す", "isRecommended": true, "feedback": "実在の人物に似た生成物を使うと、パブリシティ権等の侵害リスクがあるため事前の確認が必要。"}, {"choiceId": "ch-03-opt-2", "text": "本物ではなくAIが生成した画像だからと、そのまま広告に使用する", "isRecommended": false, "feedback": "AI生成であっても、実在人物に類似する画像の利用はパブリシティ権侵害等のリスクがある。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0007", "examId": "seisei_ai_passport", "subjectId": "ch3", "title": "RAGを使った社内ナレッジ検索システムの構築", "description": "架空の企業の情報システム部門として、RAG（検索拡張生成）を用いた社内ナレッジ検索システムを構築するストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "散在する社内文書（規程、マニュアル、議事録等）を検索できるRAGシステムの構築を始める段階。", "choices": [{"choiceId": "ch-01-opt-1", "text": "まず検索対象とする文書の範囲と、誰がどの文書を検索できるかというアクセス権限を整理する", "isRecommended": true, "feedback": "検索対象と権限を事前に整理することで、機密情報が意図せず広く検索可能になる事態を防げる。"}, {"choiceId": "ch-01-opt-2", "text": "権限管理は後回しにして、まず全社の全文書を区別なく検索対象に取り込む", "isRecommended": false, "feedback": "アクセス権限を考慮せずに取り込むと、本来見るべきでない人に機密情報が開示されるリスクがある。"}]}, {"chapterId": "ch-02", "situation": "文書をベクトル化して検索用データベースに格納する設計を検討している。", "choices": [{"choiceId": "ch-02-opt-1", "text": "文書を適切な単位（チャンク）に分割し、検索時に関連性の高い部分を取得できるようにする", "isRecommended": true, "feedback": "適切な単位に分割することで、検索精度や回答の的確さが向上しやすい。"}, {"choiceId": "ch-02-opt-2", "text": "文書全体を分割せず、そのまま1つの単位としてベクトル化する", "isRecommended": false, "feedback": "分割しないと関連性の低い情報も含めて取得されやすく、検索精度が落ちやすい。"}]}, {"chapterId": "ch-03", "situation": "運用開始後、ユーザーから「古い情報が回答に含まれている」との報告があった。", "choices": [{"choiceId": "ch-03-opt-1", "text": "元の社内文書の更新を検知し、定期的に検索用データベースを更新する仕組みを整える", "isRecommended": true, "feedback": "元データの更新を反映する仕組みがないと、RAGの回答が古い情報に基づいたままになってしまう。"}, {"choiceId": "ch-03-opt-2", "text": "最初に構築したデータベースは更新せず、そのまま使い続ける", "isRecommended": false, "feedback": "元データが更新されてもデータベースを更新しなければ、古い情報に基づく回答が続いてしまう。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0008", "examId": "seisei_ai_passport", "subjectId": "ch4", "title": "生成AI利用に関する社内ガイドライン策定プロジェクト", "description": "架空の企業の経営企画部門として、全社員向けの生成AI利用ガイドラインを策定するストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "社内向けの生成AI利用ガイドラインを策定し始める段階。", "choices": [{"choiceId": "ch-01-opt-1", "text": "機密情報・個人情報の入力禁止など、守るべき基本ルールを明文化し、全社員に周知する", "isRecommended": true, "feedback": "基本的な禁止事項を明文化して周知することで、情報漏洩等のリスクを減らせる。"}, {"choiceId": "ch-01-opt-2", "text": "社員の良識に任せ、特にルールを明文化せずに運用する", "isRecommended": false, "feedback": "ルールが明文化されていないと社員ごとに判断が分かれ、情報漏洩等のリスクが高まる。"}]}, {"chapterId": "ch-02", "situation": "ガイドラインの中で、生成AIの出力をどう扱うべきかを定める段階。", "choices": [{"choiceId": "ch-02-opt-1", "text": "生成AIの出力には誤りが含まれる可能性があることを前提に、重要な用途では人間が内容を確認する旨を定める", "isRecommended": true, "feedback": "ハルシネーション等のリスクを踏まえ、人間による確認を求めることで誤情報の拡散を防ぎやすい。"}, {"choiceId": "ch-02-opt-2", "text": "生成AIの出力は常に正確であると定め、確認の手順は設けない", "isRecommended": false, "feedback": "生成AIの出力には誤りが含まれる可能性があり、確認なしの運用は誤情報拡散のリスクがある。"}]}, {"chapterId": "ch-03", "situation": "ガイドライン策定後、現場からルールが実態に合わないとの声が上がっている。", "choices": [{"choiceId": "ch-03-opt-1", "text": "現場の意見を収集し、技術の変化や実態に応じてガイドラインを定期的に見直す", "isRecommended": true, "feedback": "現場の実態や技術の変化に応じた見直しを行うことで、ガイドラインが実効性を持ち続けられる。"}, {"choiceId": "ch-03-opt-2", "text": "一度策定したガイドラインは変更せず、そのまま維持する", "isRecommended": false, "feedback": "実態に合わないガイドラインを維持すると、守られずに形骸化するリスクがある。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0009", "examId": "seisei_ai_passport", "subjectId": "ch3", "title": "AIコーディングエージェントを使った開発プロセスの見直し", "description": "架空の企業の開発部門として、AIコーディングエージェントを活用した開発プロセスの見直しを進めるストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "開発チームがAIコーディングエージェントを使ってコード生成を進める方針を検討している。", "choices": [{"choiceId": "ch-01-opt-1", "text": "エージェントが生成したコードは、人間のレビューとテストを経てからマージする運用にする", "isRecommended": true, "feedback": "生成されたコードにも誤りや脆弱性が含まれる可能性があるため、人間によるレビューが重要。"}, {"choiceId": "ch-01-opt-2", "text": "エージェントが生成したコードは、レビューなしで直接本番環境にマージする", "isRecommended": false, "feedback": "レビューなしでのマージは、バグや脆弱性が本番環境に混入するリスクを高める。"}]}, {"chapterId": "ch-02", "situation": "AIコーディングエージェントにリポジトリへの操作権限を与える設計を検討している。", "choices": [{"choiceId": "ch-02-opt-1", "text": "タスクに必要な範囲のリポジトリ・操作権限のみを与える", "isRecommended": true, "feedback": "必要最小限の権限にすることで、意図しない変更や被害の範囲を抑えられる。"}, {"choiceId": "ch-02-opt-2", "text": "開発効率を優先し、本番環境を含む全リポジトリへの書き込み権限を最初から与える", "isRecommended": false, "feedback": "過剰な権限を与えると、誤動作時に本番環境への影響が及ぶリスクが高まる。"}]}, {"chapterId": "ch-03", "situation": "AIエージェントが生成したコードに、外部のコードをそのまま転用したと思われる特徴的な記述が含まれていることに気づいた。", "choices": [{"choiceId": "ch-03-opt-1", "text": "既存のオープンソースコード等とのライセンス上の問題がないか確認する", "isRecommended": true, "feedback": "生成コードが既存コードに類似する場合、ライセンス違反のリスクがあるため確認が必要。"}, {"choiceId": "ch-03-opt-2", "text": "AIが生成したものだからライセンスの問題はないと判断し、そのまま使用する", "isRecommended": false, "feedback": "AIが生成したコードでも既存コードに類似する場合、ライセンス上の問題が生じるリスクがある。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
{"scenarioId": "sap-story-0010", "examId": "seisei_ai_passport", "subjectId": "ch4", "title": "顧客サポート業務への生成AI導入と段階的な権限拡大", "description": "架空の企業のカスタマーサポート部門として、生成AIチャットボットを段階的に導入し、権限を拡大していくストーリー。", "chapters": [{"chapterId": "ch-01", "situation": "顧客サポート業務にAIチャットボットを導入する初期段階。", "choices": [{"choiceId": "ch-01-opt-1", "text": "まずは一般的な質問への一次回答に限定し、複雑な相談は人間のオペレーターに引き継ぐ範囲から始める", "isRecommended": true, "feedback": "限定的な範囲から始めることで、リスクを抑えながら効果を検証できる。"}, {"choiceId": "ch-01-opt-2", "text": "最初から全ての顧客対応をAIに完全に任せ、人間のオペレーターへの引き継ぎは設けない", "isRecommended": false, "feedback": "複雑な相談まで任せると、顧客対応の質が下がったり問題が生じたりするリスクが高い。"}]}, {"chapterId": "ch-02", "situation": "運用実績が積み上がり、AIに任せる範囲を拡大するかどうかを検討している。", "choices": [{"choiceId": "ch-02-opt-1", "text": "対応実績やエラー率などのデータを検証し、問題がないことを確認しながら段階的に権限を拡大する", "isRecommended": true, "feedback": "データに基づいて段階的に権限を拡大することで、リスクを管理しながら適用範囲を広げられる。"}, {"choiceId": "ch-02-opt-2", "text": "検証を行わず、感覚的に良さそうだという理由だけで一気に対応範囲を拡大する", "isRecommended": false, "feedback": "十分な検証なしに対応範囲を拡大すると、想定していなかった問題が顧客対応全体に広がるリスクがある。"}]}, {"chapterId": "ch-03", "situation": "AIが返金に関する判断まで行えるように権限を拡大する提案が出た。", "choices": [{"choiceId": "ch-03-opt-1", "text": "金額や条件に応じて、一定以上の返金は人間の承認を必須とする仕組みを組み込む", "isRecommended": true, "feedback": "金銭に関わる重要な判断には人間の承認を組み込むことで、誤った自動処理による損失を防ぎやすい。"}, {"choiceId": "ch-03-opt-2", "text": "顧客満足度を優先し、返金の判断も金額にかかわらず全てAIに一任する", "isRecommended": false, "feedback": "金銭に関わる重要な判断を人間の確認なしにAIへ一任すると、誤判断による損失リスクが大きい。"}]}], "source": "original", "sourceRef": "自作（シラバスに基づくストーリー型例題）", "contentVer": "2026.10.6"}
